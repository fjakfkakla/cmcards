# Le réseau Solana : devnet pour tester, mainnet-beta pour les vrais SOL
NEXT_PUBLIC_SOLANA_CLUSTER=devnet
# Un RPC dédié (Helius, Triton…) : le RPC public de mainnet refuse souvent les navigateurs
NEXT_PUBLIC_SOLANA_RPC=
# Le RPC du serveur, s'il diffère (clé privée possible : jamais exposée au navigateur)
SOLANA_RPC=
# Le wallet de cm cards : il reçoit le prix des boosters et le 1 % du marché
NEXT_PUBLIC_TREASURY=
# Une longue chaîne au hasard : signe les cookies de connexion (openssl rand -hex 32)
SESSION_SECRET=
# Le stockage (Upstash Redis, via l'intégration Vercel : les KV_REST_API_* marchent aussi)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
