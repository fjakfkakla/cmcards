# Toutes ces variables vont sur RAILWAY (service cm cards). Vercel n'en a aucune :
# il sert les pages et renvoie /api/* à Railway (next.config.ts › RAILWAY).

# Le réseau Solana : devnet pour tester, mainnet-beta pour les vrais SOL
SOLANA_CLUSTER=devnet
# Le RPC du serveur (peut porter une clé : il ne sort jamais du serveur)
SOLANA_RPC=
# Le RPC donné aux navigateurs (public ; le RPC public de mainnet refuse souvent les navigateurs)
SOLANA_RPC_PUBLIC=
# Le wallet de cm cards : il reçoit le prix des boosters et le 1 % du marché
TREASURY_WALLET=
# Une longue chaîne au hasard : signe les cookies de connexion (openssl rand -hex 32)
SESSION_SECRET=
# Le Redis du projet Railway : la référence ${{Redis.REDIS_URL}}
REDIS_URL=
